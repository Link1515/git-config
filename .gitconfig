[core]
    autocrlf = input
    excludesFile = ~/.gitignore
[column]
    ui = auto
[branch]
    sort = -committerdate
[pull]
    rebase = true
    ff = only
[merge]
    ff = only
[advice]
    diverging = false
[alias]
	msg = "!f(){ if git diff --cached --quiet; then echo 'No staged changes.'; return 1; fi; d=$PWD; found=''; while [ \"$d\" != / ]; do if [ -f \"$d/.agents/skills/git-msg/SKILL.md\" ]; then found=1; break; fi; d=$(dirname \"$d\"); done; if [ -z \"$found\" ] && [ -f \"$HOME/.codex/skills/git-msg/SKILL.md\" ]; then found=1; fi; if [ -z \"$found\" ] && [ -f /etc/codex/skills/git-msg/SKILL.md ]; then found=1; fi; if [ -z \"$found\" ]; then echo 'Skill not found: git-msg. Add git-msg/SKILL.md under .agents/skills, ~/.agents/skills, or /etc/codex/skills.'; return 1; fi; diff=$(git diff --cached); printf '%s\n%s\n' \"$diff\" '$git-msg' | codex exec 2>/dev/null; }; f"
    cm = commit -m
    cmp = commit --amend -C HEAD
    co = checkout
    pushf = push --force-with-lease
    sh = stash
    st = status
    sts = status -s
    br = branch
    ll = log --pretty=format:'%C(yellow)%h%C(reset) %ad [%C(cyan)%an%C(reset)]%C(yellow)%d%C(reset) %s %C(green)(%cr)%C(reset)' --date=short
    lg = log --graph --pretty=format:'%C(yellow)%h%C(reset) %ad [%C(cyan)%an%C(reset)]%C(yellow)%d%C(reset) %s' --abbrev-commit --date=short
    alias = config --get-regexp ^alias\\.
    iac = "!giac() { git init && git add . && git commit -m 'Initial commit' ;}; giac"
    ac = "!git add . && git commit -m"
    rc = "!grc() { git reset --hard && git clean -fd ;}; read -p 'Do you want to run the following commands:\ngit reset --hard && git clean -fd\n\n(Y/N) ' answer && [[ $answer == [Yy] ]] && grc"
    pr = "!gpr() { \
		remote=${2:-origin}; prId=\"$1\"; \
		if [ -z \"$prId\" ]; then \
			echo \"Usage: git pr <pr-id> [remote] (default: origin)\" >&2; return 2; \
		fi; \
		git fetch \"$remote\" \"pull/$prId/head:pr-$prId\" && git checkout \"pr-$prId\"; \
	}; gpr"
    fpr = "!f(){ url=\"$1\"; sameRepoRemote=${2:-origin}; if [ $# -lt 1 ] || [ $# -gt 2 ]; then echo \"Usage: git fpr <github-pr-url> [same-repo-remote] (default: origin)\" >&2; return 2; fi; case \"$url\" in https://github.com/*/*/pull/[0-9]*|https://github.com/*/*/pull/[0-9]*/) ;; *) echo \"Usage: git fpr <github-pr-url> [same-repo-remote] (default: origin)\" >&2; return 2 ;; esac; repoPath=$(printf '%s' \"$url\" | cut -d/ -f4-5); prId=$(printf '%s' \"$url\" | cut -d/ -f7); apiUrl=\"https://api.github.com/repos/$repoPath/pulls/$prId\"; if ! command -v curl >/dev/null 2>&1; then echo \"curl is required.\" >&2; return 2; fi; if ! command -v perl >/dev/null 2>&1; then echo \"perl is required.\" >&2; return 2; fi; if ! git remote get-url \"$sameRepoRemote\" >/dev/null 2>&1; then echo \"Remote '$sameRepoRemote' does not exist.\" >&2; return 2; fi; sameRepoUrl=$(git remote get-url \"$sameRepoRemote\"); normalize_repo_url(){ printf '%s' \"$1\" | perl -e '$u = do { local $/; <> }; chomp $u; $u =~ s/\\.git$//; $u =~ s#^git\\@github\\.com:#https://github.com/#; $u =~ s#^ssh://git\\@github\\.com/#https://github.com/#; $u =~ s#^git://github\\.com/#https://github.com/#; print lc $u;'; }; normalizedSameRepoUrl=$(normalize_repo_url \"$sameRepoUrl\"); parsed=$(curl -fsSL -H \"Accept: application/vnd.github+json\" \"$apiUrl\" | perl -MJSON::PP -e 'eval { $json = decode_json(do { local $/; <> }); $clone = $json->{head}{repo}{clone_url} // q(); $ref = $json->{head}{ref} // q(); die if !$clone || !$ref; print join(chr(10), $clone, $ref), chr(10); 1 } or exit 1;') || { echo \"Failed to fetch PR metadata: $apiUrl\" >&2; return 1; }; cloneUrl=$(printf '%s\n' \"$parsed\" | sed -n '1p'); headRef=$(printf '%s\n' \"$parsed\" | sed -n '2p'); if [ -z \"$cloneUrl\" ] || [ -z \"$headRef\" ]; then echo \"Failed to parse PR metadata from GitHub API.\" >&2; return 1; fi; normalizedCloneUrl=$(normalize_repo_url \"$cloneUrl\"); branch=\"pr-$prId\"; if [ \"$normalizedCloneUrl\" = \"$normalizedSameRepoUrl\" ]; then git fetch \"$sameRepoRemote\" \"pull/$prId/head:$branch\" && git checkout \"$branch\"; return $?; fi; remote=\"pr-$prId\"; if git remote get-url \"$remote\" >/dev/null 2>&1; then existingUrl=$(git remote get-url \"$remote\"); normalizedExistingUrl=$(normalize_repo_url \"$existingUrl\"); if [ \"$normalizedExistingUrl\" != \"$normalizedCloneUrl\" ]; then echo \"Remote '$remote' already exists and points to a different URL.\" >&2; return 1; fi; fi; if git remote get-url \"$remote\" >/dev/null 2>&1; then git remote set-url \"$remote\" \"$cloneUrl\"; else git remote add \"$remote\" \"$cloneUrl\"; fi; git fetch \"$remote\" \"refs/heads/$headRef:refs/remotes/$remote/$headRef\" && git checkout -B \"$branch\" \"$remote/$headRef\"; git branch --set-upstream-to=\"$remote/$headRef\" \"$branch\"; }; f"
